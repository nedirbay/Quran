  "totalAyahs": 29,
  "ayahs": [
    {
      "number": 1,
      "arabic": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
      "turkmen": "Gün düýrülip (ýagtysy öçürilende),"
    },
    {
      "number": 2,
      "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
      "turkmen": "Ýyldyzlar dökülip darganda,"
    },
    {
      "number": 3,
      "arabic": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",
      "turkmen": "Daglar ýerinden gozgalyp ýöredilende,"
    },
    {
      "number": 4,
      "arabic": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
      "turkmen": "On aýlyk bogaz düýeler eýesiz taşlananda,"
    },
    {
      "number": 5,
      "arabic": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
      "turkmen": "Ýabany haýwanlar bir ýere ýygnalanda,"
    },
    {
      "number": 6,
      "arabic": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",
      "turkmen": "Deňizler gaýnadylyp oda öwrülende,"
    },
    {
      "number": 7,
      "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
      "turkmen": "Janlar (bedenler bilen) birleşdirilende,"
    },
    {
      "number": 8,
      "arabic": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",
      "turkmen": "Diriligine gömlen gyz çagasyndan soralanda:"
    },
    {
      "number": 9,
      "arabic": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ",
      "turkmen": "«Haýsy günäsi üçin öldürildi?» diýlip;"
    },
    {
      "number": 10,
      "arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",
      "turkmen": "Amal depderleri açylanda,"
    },
    {
      "number": 11,
      "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",
      "turkmen": "Asman sypyrylyp aýrylanda,"
    },
    {
      "number": 12,
      "arabic": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",
      "turkmen": "Jähennem güýçli tutaşdyrylanda,"
    },
    {
      "number": 13,
      "arabic": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
      "turkmen": "We jennet ýakynlaşdyrylanda,"
    },
    {
      "number": 14,
      "arabic": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ",
      "turkmen": "Her bir jan öz getiren (eden) zadyny biler."
    },
    {
      "number": 15,
      "arabic": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",
      "turkmen": "Ýok! Gündiz gizlenip,"
    },
    {
      "number": 16,
      "arabic": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
      "turkmen": "Gije peýda bolup ýöreýän we ýerine girýän ýyldyzlara ant edýärin!"
    },
    {
      "number": 17,
      "arabic": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ",
      "turkmen": "Garaňkylygy bilen gelýän gijä ant bolsun!"
    },
    {
      "number": 18,
      "arabic": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
      "turkmen": "Dem alyp ýagtylyp başlan daňa ant bolsun!"
    },
    {
      "number": 19,
      "arabic": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ",
      "turkmen": "Hakykatdan-da, ol (Gurhan) hormatly bir ilçiniň (Jebraýylyň) getiren sözüdir."
    },
    {
      "number": 20,
      "arabic": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ",
      "turkmen": "Ol güýç-kuwwat eýesidir, Arşyň Eýesiniň ýanynda mertebesi belentdir."
    },
    {
      "number": 21,
      "arabic": "مُّطَاعٖ ثَمَّ أَمِينٖ",
      "turkmen": "Ol ýerde oňa boýun egilýändir, ol ynamdardyr."
    },
    {
      "number": 22,
      "arabic": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ",
      "turkmen": "Siziň ýoldaşyňyz (Muhammet) däli däldir."
    },
    {
      "number": 23,
      "arabic": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",
      "turkmen": "Kasam bolsun, ol ony (Jebraýyly) açyk gözýetimde gördi."
    },
    {
      "number": 24,
      "arabic": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ",
      "turkmen": "Ol gaýyp habarlaryna (wahyýa) garşy gysganç däldir."
    },
    {
      "number": 25,
      "arabic": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ",
      "turkmen": "Ol (Gurhan) daşlanan şeýtanyň sözi däldir."
    },
    {
      "number": 26,
      "arabic": "فَأَيۡنَ تَذۡهَبُونَ",
      "turkmen": "Onda siz nirä barýarsyňyz?"
    },
    {
      "number": 27,
      "arabic": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
      "turkmen": "Ol diňe älemler üçin bir öwüt-ündewdir;"
    },
    {
      "number": 28,
      "arabic": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ",
      "turkmen": "Aranyzdan dogry ýolda ýöremek isleýänler üçin."
    },
    {
      "number": 29,
      "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
      "turkmen": "Älemleriň Rabby bolan Allah islemese, siz isläp bilmersiňiz!"
    }
  ]
