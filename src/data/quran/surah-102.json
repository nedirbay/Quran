  "ayahs": [
    {
      "number": 1,
      "arabic": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
      "turkmen": "Köpeltmek (mal-dünýä we san taýdan öwünmek) höwesi sizi güýmedi,"
    },
    {
      "number": 2,
      "arabic": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
      "turkmen": "Tä gabyrlara barýançaňyz (ölýänçäňiz)."
    },
    {
      "number": 3,
      "arabic": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "turkmen": "Ýok, beýle däl! Tiz wagtda bilersiňiz!"
    },
    {
      "number": 4,
      "arabic": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "turkmen": "Ýene-de ýok! Tiz wagtda bilersiňiz!"
    },
    {
      "number": 5,
      "arabic": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
      "turkmen": "Ýok! Eger siz anyk ylym bilen bilsediňiz (beýle etmezdiňiz)."
    },
    {
      "number": 6,
      "arabic": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
      "turkmen": "Kasam bolsun, siz ol jähennemi hökman görersiňiz!"
    },
    {
      "number": 7,
      "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
      "turkmen": "Ýene kasam bolsun, ony gözüňiz bilen anyk görersiňiz!"
    },
    {
      "number": 8,
      "arabic": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "turkmen": "Soňra şol gün size berlen ähli nygmatlardan hökman soraga çekilersiňiz!"
