  "ayahs": [
    {
      "number": 1,
      "arabic": "ٱلۡقَارِعَةُ",
      "turkmen": "Elhenç ses bilen ýürekleri ýarýan apy-tupan (Karia)!"
    },
    {
      "number": 2,
      "arabic": "مَا ٱلۡقَارِعَةُ",
      "turkmen": "Nämedir ol Karia?"
