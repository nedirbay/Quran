{
  "id": 93,
  "nameArabic": "الضحى",
  "nameTranslit": "Ad-Duhaa",
  "nameTurkmen": "Duha",
  "revelation": "mekke",
  "totalAyahs": 11,
  "ayahs": [
    {
      "number": 1,
      "arabic": "وَٱلضُّحَىٰ",
      "turkmen": "Guşluk wagtyna ant bolsun!"
    },
    {
      "number": 2,
      "arabic": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
      "turkmen": "Ümsümlik çöken wagty gijä ant bolsun!"
    },
    {
      "number": 3,
      "arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "turkmen": "Rabbyň seni terk etmedi we saňa gaharlanmady."
    },
    {
      "number": 4,
      "arabic": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ",
      "turkmen": "Elbetde, ahyret seniň üçin dünýäden has haýyrlydyr."
    },
    {
      "number": 5,
      "arabic": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
      "turkmen": "Rabbyň saňa (köp nygmatlar) berer we sen hoşal bolarsyň."
    },
    {
      "number": 6,
      "arabic": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ",
      "turkmen": "Ol seni ýetim tapyp, penasyna almadymy?"
    },
    {
      "number": 7,
      "arabic": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ",
      "turkmen": "Ol seni ýol bilmez ýagdaýda tapyp, dogry ýola gönükdirmedimi?"
    },
    {
      "number": 8,
      "arabic": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ",
      "turkmen": "Ol seni mätäç ýagdaýda tapyp, baý etmedimi?"
    },
    {
      "number": 9,
      "arabic": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
      "turkmen": "Onda ýetime azar berme!"
    },
    {
      "number": 10,
      "arabic": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
      "turkmen": "Dilegçini hem kowma!"
    },
    {
      "number": 11,
      "arabic": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
      "turkmen": "Rabbyňyň nygmatyny bolsa (şükür bilen) ýatlap dur!"
    }
  ]
}
